.login-page{padding:32rpx;min-height:100vh;box-sizing:border-box;background:#f5f7f2;color:#000;font-size:30rpx}
.login-title{display:block;font-size:40rpx;font-weight:600;margin:24rpx 0}
.login-note{display:block;font-size:28rpx;line-height:1.8;margin:20rpx 0;color:#000}
.login-card{padding:32rpx;background:#fff;border:1rpx solid #dce5d8;border-radius:24rpx}
.label{display:block;margin:24rpx 0 12rpx;font-weight:600}
.field{display:block;box-sizing:border-box;min-height:88rpx;height:88rpx;padding:20rpx;background:#eef2e9;border-radius:12rpx;font-size:30rpx;color:#000}
.login-button{margin:32rpx 0 0;background:#42684d;color:#fff;font-size:30rpx;line-height:88rpx;border-radius:16rpx}
.login-error{display:block;margin-top:24rpx;padding:20rpx;background:#fff0e7;border-radius:12rpx;color:#000;line-height:1.7;font-size:28rpx}
