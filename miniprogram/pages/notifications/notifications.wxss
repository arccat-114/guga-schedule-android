.settings{min-height:100vh;background:#f5f7f2;padding:28rpx;box-sizing:border-box;color:#000;font-size:30rpx;line-height:1.6}
.card{background:#fff;border:1rpx solid #dfe6da;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}
.heading{display:block;font-size:34rpx;font-weight:600}.hint{display:block;font-size:28rpx;line-height:1.75;margin-top:18rpx}
.row{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx}.label{flex:1;min-width:0;margin-right:16rpx}
.beta-label{display:block;font-size:28rpx;line-height:1.6;color:#000}
.time-choice{padding:22rpx 18rpx;background:#edf2e8;border:1rpx solid #bdcdb8;border-radius:14rpx;margin-top:18rpx;font-size:30rpx}
.minutes-row{display:flex;align-items:center;margin-top:20rpx}.minutes-row input{flex:1;min-width:0;margin:0 20rpx;background:#f3f5f0;border:1rpx solid #bdcdb8;padding:18rpx;border-radius:12rpx;height:52rpx;font-size:32rpx;color:#000}
.primary,.secondary{width:100%;box-sizing:border-box;padding:22rpx 16rpx;font-size:30rpx;line-height:1.5;margin-top:22rpx;border-radius:16rpx}
.primary{background:#42684d;color:#fff}.secondary{background:#edf2e8;color:#000;border:1rpx solid #bdcdb8}.message{display:block;margin-top:24rpx;font-size:28rpx;line-height:1.75}.error{padding:18rpx;background:#fff0e7;border-radius:12rpx}
.test-link{display:inline-block;width:auto;min-width:0!important;padding:12rpx 16rpx;margin:22rpx 0 0;border:1rpx solid #bdcdb8;border-radius:12rpx;background:#fff;color:#000;font-size:28rpx;line-height:1.5}
.theme-ocean{background:#f2f6f8}.theme-ocean .primary{background:#356580}.theme-ocean .secondary,.theme-ocean .time-choice{background:#eff4f7}
.theme-amber{background:#faf6ef}.theme-amber .primary{background:#986033}.theme-amber .secondary,.theme-amber .time-choice{background:#f8f2e9}
.button-hover{opacity:.8;transform:scale(.96)}button{transition:transform 140ms ease-out,opacity 140ms ease-out}
.card{animation:settings-enter 260ms cubic-bezier(.22,.68,0,1)}
@keyframes settings-enter{from{opacity:.35;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){button{transition:none}.button-hover{transform:none}.card{animation:none}}
